# Kopiera denna fil till .env och fyll i dina nycklar.
# Lägg .env på din Raspberry Pi (aldrig i git).

# Intervals.icu
# Hämta API-nyckel: Intervals.icu -> Settings -> Developer -> "API Key"
# Hämta athlete id: siffrorna i din Intervals-profil-URL, t.ex. https://intervals.icu/athletes/12345 -> i12345
INTERVALS_API_KEY=your_intervals_api_key_here
INTERVALS_ATHLETE_ID=i12345

# Anthropic (Claude Sonnet 5)
# Hämta nyckel: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5


# Web-app
# Nyckeln till webben. Krävs så fort servern lyssnar på nätverket (WEB_HOST
# annat än 127.0.0.1): utan den vägrar servern starta, eftersom sidan annars
# vore öppen för alla som når porten, och /chat och /analyze/* kostar ett
# Anthropic-anrop var. Ett slumpat värde:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Öppna sidan en gång per enhet med ?token=<värdet>. Enheten får en kaka och
# tokenet försvinner ur adressen. Det är ett hemnätverksskydd över vanlig
# http, inte autentisering. För åtkomst utifrån: Tailscale eller en
# TLS-proxy, aldrig en öppnad port.
WEB_ACCESS_TOKEN=
# Bindning för uvicorn
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Atletprofil
# Läggs in i systemprompten som kontext till alla analyser, så Claude vet
# vem den skriver till. Alla fält är frivilliga — det som lämnas tomt
# utelämnas ur prompten i stället för att gissas.
# Uppgifterna stannar i din .env (gitignorerad) och hamnar aldrig i koden.
# Exempelvärdena nedan är påhittade — byt ut dem mot dina egna.
# Tilltalsnamn. Används i webbens hälsning ("God morgon Anna!") och i
# prompten, så att analyserna tilltalar dig vid namn. Lämnas det tomt
# hälsar sidan utan namn och analyserna skriver opersonligt.
ATHLETE_NAME=Anna
ATHLETE_SEX=kvinna
ATHLETE_BIRTH_DATE=1980-05-14
ATHLETE_HEIGHT_CM=172
# Fritext. Skriv sådant som bör påverka råd om intensitet och puls, t.ex.
# en hjärtåkomma eller en gammal skada. Fältet skickas till Anthropic som
# en del av prompten — skriv bara sådant du är bekväm med att dela.
# Lämna tomt om inget är relevant.
ATHLETE_MEDICAL=
# Fritext: hur din vecka brukar se ut.
ATHLETE_ROUTINE=styrketräning 2-3 gånger/vecka, löpning 1-2 gånger/vecka
# Fritext: vad du tränar mot.
ATHLETE_GOAL=hållbar träning med fokus på hälsa och kondition

# Vikten fylls INTE i här — den hämtas från Intervals eller från det du
# säger i chatten, så den följer med när den ändras.

# Sökväg till SQLite-databas
DB_PATH=data/training.db

# Schemaläggning (timmar mellan Intervals-sync)
SYNC_INTERVAL_HOURS=1
# Tid på morgonen (HH:MM, lokal Pi-tid) då morgonrekommendation genereras.
# Sätts till när din sömndata brukar ha synkats från Garmin (default 07:00).
# Görs om varje heltimme i fyra timmar efter den tiden, tills ny sömndata
# faktiskt kommit in.
MORNING_RECOMMENDATION_TIME=07:00
# Tid mitt på dagen (HH:MM) då träningsanalysen genereras — när dagens
# data hunnit synkas, men innan du planerat kvällens pass.
COACHING_TIME=12:00
# Tid på kvällen (HH:MM) då kvällssammanfattning genereras.
EVENING_SUMMARY_TIME=23:59
# Tid nästa morgon (HH:MM) då gårdagens kvällssammanfattning kontrolleras
# mot eftersynkat underlag och görs om vid behov. Garmin/Intervals.icu
# är inte alltid färdigsynkad med dygnet till 23:59: steg efterjusteras,
# natten räknas om, och ett pass som låg kvar i klockan laddas upp först
# på morgonen.
EVENING_SUMMARY_RECHECK_TIME=09:00

# Nattlig backup av databasen. Databasen är enda kopian av analyserna, det
# du rapporterat i chatten och dina styrkeset — Intervals har bara rådatan.
# Tid (HH:MM) då kopian tas, mellan kvällens och morgonens jobb.
BACKUP_TIME=03:30
# Hur många dagars kopior som sparas innan de äldsta rensas.
BACKUP_KEEP=14

# Hur länge ersatta versioner av en analys sparas. Genererar du om en dags
# analys ligger den gamla kvar så här länge; den NYASTE versionen av varje
# dygn sparas alltid, oavsett ålder. 0 stänger av gallringen.
# ANALYSIS_KEEP_DAYS=30

# Kör de dagliga analyserna en gång direkt vid uppstart, så att en omstart
# strax efter en schemalagd tid inte betyder att dagens analys uteblir. En
# missad nattlig backup tas också igen här.
# Sätt 0 när du startar appen bara för att titta på gränssnittet — annars
# genererar varje omstart betalda analyser.
# STARTUP_CATCHUP=1

# Sätt 0 för en ren webbserver utan schemalagda jobb (synk, analyser,
# backup) och utan uppstarts-catchup. För en andra instans som delar
# databas med en som redan kör jobben, och inte ska göra dem en gång till.
# SCHEDULER_ENABLED=1

# Övningar som inte ska erbjudas i progressionsväljaren på dashboarden.
# Kommaseparerat, versaler spelar ingen roll. Accessoarlyft, uppvärmnings-
# moment och FIT-poster vars övningsnamn inte gick att tolka fyller annars
# listan utan att ha någon utveckling att visa. Ingenting raderas — datan
# finns kvar och räknas fortfarande in i volymen.
# PROGRESSION_HIDDEN_EXERCISES=okänd övning,slädpush
# Var kopiorna hamnar. Default är data/backups bredvid databasen, vilket
# skyddar mot tappade skrivningar och felaktiga raderingar — men INTE mot
# att lagringsmediet dör. Peka den på en monterad disk eller nätverksplats
# för att skydda mot det.
# BACKUP_DIR=/mnt/usb/garmin-backup

# Molnmål för backuperna, som rclone skriver det: <fjärr>:<sökväg>.
# Fjärren sätts upp en gång med `rclone config` och läses sedan av
# scripts/ladda-upp-backup.sh, som körs av
# garmin-ai-pi-backup-upload.timer strax efter den nattliga backupen.
# Det här är skyddet mot att SD-kortet dör — BACKUP_DIR ovan ligger som
# default på samma kort som databasen, så en kopia där försvinner med
# originalet.
# BACKUP_REMOTE=jottacloud:garmin-ai-pi/backups
